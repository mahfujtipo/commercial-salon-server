PORT=8000
NODE_ENV=development

# MongoDB connection string (database used: salon-database)
MONGODB_URI=your_mongodb_connection_string

# Next.js client URL (used for CORS)
CLIENT_URI=http://localhost:3000

# Better Auth base URL (JWKS is read from {BETTER_AUTH_URL}/api/auth/jwks)
BETTER_AUTH_URL=http://localhost:3000

# ImgBB image hosting API key (kept only on the server)
IMGBB_API_KEY=your_imgbb_api_key

# Optional: only set if configured in Better Auth's jwt plugin
# JWT_ISSUER=
# JWT_AUDIENCE=

# Optional: Better Auth user collection name (default: user)
# USER_COLLECTION=user
